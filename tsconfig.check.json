// 类型检查专用配置（`npm run typecheck` 走这个）
//
// 主配置 references tsconfig.node.json（composite + noEmit 冲突会导致 vue-tsc
// 报 TS6310），故另开一份剥掉 references 只查 src/。
// 本文件不参与构建：vite build 只做 esbuild 转译、不做类型检查。
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    // 跨机器开发时路径大小写不一致会在其中一边静默失败
    "forceConsistentCasingInFileNames": true,
    // GM_* 全局函数声明在 vite-plugin-monkey/global 里
    "types": ["vite/client", "vite-plugin-monkey/client", "vite-plugin-monkey/global"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "references": []
}
